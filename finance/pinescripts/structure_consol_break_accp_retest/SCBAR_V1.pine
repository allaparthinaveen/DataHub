//@version=6
indicator(
     "Structure → Consolidation → Breakout → Acceptance → Retest",
     overlay=true,
     max_boxes_count=10,
     max_lines_count=100,
     max_labels_count=100)

//====================================================================
// INPUTS
//====================================================================

//────────────────────────────────────────────────────────────────────
// STRUCTURE
//────────────────────────────────────────────────────────────────────

groupStructure = "1. Structure"

pivotLen       = input.int(3, "Pivot Length", minval=1, group=groupStructure)
minTrendSwings = input.int(2, "Minimum Trend Swings", minval=1, group=groupStructure)
showStructure  = input.bool(true, "Show HH/LH/HL/LL", group=groupStructure)


//────────────────────────────────────────────────────────────────────
// CONSOLIDATION
//────────────────────────────────────────────────────────────────────

groupConsolidation = "2. Consolidation"

minConsBars       = input.int(5, "Minimum Consolidation Bars", minval=3, group=groupConsolidation)
maxConsBars       = input.int(40, "Maximum Consolidation Bars", minval=5, group=groupConsolidation)

maxBoxPct         = input.float(
     3.0,
     "Maximum Box Range %",
     minval=0.1,
     step=0.1,
     group=groupConsolidation)

atrLen            = input.int(
     14,
     "ATR Length",
     minval=1,
     group=groupConsolidation)

atrLookback       = input.int(
     20,
     "ATR Compression Lookback",
     minval=5,
     group=groupConsolidation)

maxAtrRatio       = input.float(
     0.90,
     "Maximum ATR Ratio",
     minval=0.1,
     step=0.05,
     group=groupConsolidation)

swingLookback     = input.int(
     10,
     "Swing Containment Lookback",
     minval=3,
     group=groupConsolidation)

maxExpansion      = input.float(
     1.20,
     "Maximum Swing Expansion",
     minval=1.0,
     step=0.05,
     group=groupConsolidation)


//────────────────────────────────────────────────────────────────────
// BREAKOUT ENGINE
//────────────────────────────────────────────────────────────────────

groupBreakout = "3. Breakout Score Engine"

breakoutBuffer = input.float(
     0.10,
     "Breakout Buffer %",
     minval=0.0,
     step=0.05,
     group=groupBreakout)

minBodyATR = input.float(
     0.30,
     "Minimum Body ATR",
     minval=0.05,
     step=0.05,
     group=groupBreakout)

minBodyRatio = input.float(
     0.50,
     "Minimum Body / Candle Ratio",
     minval=0.1,
     maxval=1.0,
     step=0.05,
     group=groupBreakout)

minCloseLoc = input.float(
     0.65,
     "Minimum Close Location",
     minval=0.5,
     maxval=1.0,
     step=0.05,
     group=groupBreakout)

useVolume = input.bool(
     true,
     "Use Volume Score",
     group=groupBreakout)

volumeLength = input.int(
     20,
     "Volume Average Length",
     minval=5,
     group=groupBreakout)

volumeMult = input.float(
     1.15,
     "Minimum Relative Volume",
     minval=0.5,
     step=0.05,
     group=groupBreakout)

maxBreakoutATR = input.float(
     2.50,
     "Maximum Breakout Candle ATR",
     minval=0.5,
     step=0.25,
     group=groupBreakout)

minBreakoutScore = input.int(
     4,
     "Minimum Breakout Score / 5",
     minval=1,
     maxval=5,
     group=groupBreakout)


//────────────────────────────────────────────────────────────────────
// ACCEPTANCE ENGINE
//────────────────────────────────────────────────────────────────────

groupAcceptance = "4. Acceptance Engine"

// How many candles must be observed AFTER breakout.
// This is NOT the acceptance condition by itself.
// It simply prevents same-candle acceptance.
acceptanceWatchBars = input.int(
     1,
     "Minimum Acceptance Watch Bars",
     minval=1,
     maxval=5,
     group=groupAcceptance)

// Acceptance quality score.
// 3/5 is deliberately moderate to avoid over-filtering.
minAcceptanceScore = input.int(
     3,
     "Minimum Acceptance Score / 5",
     minval=2,
     maxval=5,
     group=groupAcceptance)

// Maximum retracement back toward the broken level
// before acceptance is considered weak.
maxAcceptanceRetrace = input.float(
     0.50,
     "Maximum Acceptance Retracement %",
     minval=0.05,
     step=0.05,
     group=groupAcceptance)

// Strong opposite candle threshold.
oppositeBodyATR = input.float(
     0.50,
     "Opposite Candle Failure Body ATR",
     minval=0.1,
     step=0.05,
     group=groupAcceptance)

// Wick rejection threshold.
maxRejectionWick = input.float(
     0.45,
     "Maximum Rejection Wick Ratio",
     minval=0.1,
     maxval=0.9,
     step=0.05,
     group=groupAcceptance)

// Follow-through minimum body.
acceptanceBodyATR = input.float(
     0.20,
     "Follow-through Body ATR",
     minval=0.05,
     step=0.05,
     group=groupAcceptance)

// Volume deterioration tolerance.
// Example: 0.60 means subsequent volume can fall to 60%
// of breakout volume without automatically failing.
minVolumeRetention = input.float(
     0.60,
     "Minimum Volume Retention",
     minval=0.1,
     maxval=1.0,
     step=0.05,
     group=groupAcceptance)


//────────────────────────────────────────────────────────────────────
// RETEST
//────────────────────────────────────────────────────────────────────

groupRetest = "5. Retest"

retestBars = input.int(
     10,
     "Retest Window Bars",
     minval=1,
     group=groupRetest)

retestBuffer = input.float(
     0.25,
     "Retest Buffer %",
     minval=0.05,
     step=0.05,
     group=groupRetest)


//────────────────────────────────────────────────────────────────────
// DISPLAY
//────────────────────────────────────────────────────────────────────

groupDisplay = "6. Display"

showBox        = input.bool(true, "Show Consolidation Box", group=groupDisplay)
showLevels     = input.bool(true, "Show S/R Levels", group=groupDisplay)
showBreakout   = input.bool(true, "Show Breakout", group=groupDisplay)
showAcceptance = input.bool(true, "Show Acceptance", group=groupDisplay)
showRetest     = input.bool(true, "Show Retest", group=groupDisplay)
showEntry      = input.bool(true, "Show Entry", group=groupDisplay)


//====================================================================
// ATR
//====================================================================

atr = ta.atr(atrLen)


//====================================================================
// STRUCTURE ENGINE
//====================================================================

ph = ta.pivothigh(high, pivotLen, pivotLen)
pl = ta.pivotlow(low, pivotLen, pivotLen)

var float prevHigh = na
var float lastHigh = na

var float prevLow = na
var float lastLow = na

bool newHH = false
bool newLH = false
bool newHL = false
bool newLL = false

if not na(ph)

    prevHigh := lastHigh
    lastHigh := ph

    if not na(prevHigh)

        if ph > prevHigh
            newHH := true

        else if ph < prevHigh
            newLH := true


if not na(pl)

    prevLow := lastLow
    lastLow := pl

    if not na(prevLow)

        if pl > prevLow
            newHL := true

        else if pl < prevLow
            newLL := true


//====================================================================
// STRUCTURE LABELS
//====================================================================

if showStructure and newHH

    label.new(
         bar_index - pivotLen,
         ph,
         "HH",
         style=label.style_label_down,
         color=color.new(color.green, 0),
         textcolor=color.white,
         size=size.tiny)


if showStructure and newLH

    label.new(
         bar_index - pivotLen,
         ph,
         "LH",
         style=label.style_label_down,
         color=color.new(color.red, 0),
         textcolor=color.white,
         size=size.tiny)


if showStructure and newHL

    label.new(
         bar_index - pivotLen,
         pl,
         "HL",
         style=label.style_label_up,
         color=color.new(color.green, 0),
         textcolor=color.white,
         size=size.tiny)


if showStructure and newLL

    label.new(
         bar_index - pivotLen,
         pl,
         "LL",
         style=label.style_label_up,
         color=color.new(color.red, 0),
         textcolor=color.white,
         size=size.tiny)


//====================================================================
// STRUCTURE REGIME
//====================================================================

var int trend = 0

var int bullishSwings = 0
var int bearishSwings = 0

if newHH or newHL

    bullishSwings += 1
    bearishSwings := 0

if newLH or newLL

    bearishSwings += 1
    bullishSwings := 0

if bullishSwings >= minTrendSwings
    trend := 1

if bearishSwings >= minTrendSwings
    trend := -1


//====================================================================
// CONSOLIDATION ENGINE
//====================================================================

recentHigh = ta.highest(high, minConsBars)
recentLow  = ta.lowest(low, minConsBars)

consRange = recentHigh - recentLow

priceCompression =
     recentLow > 0 and
     (consRange / recentLow * 100.0) <= maxBoxPct

atrAverage = ta.sma(atr, atrLookback)

atrCompression =
     not na(atrAverage) and
     atrAverage > 0 and
     atr / atrAverage <= maxAtrRatio

swingHighRange = ta.highest(high, swingLookback)
swingLowRange  = ta.lowest(low, swingLookback)

swingRange = swingHighRange - swingLowRange

swingContained =
     consRange > 0 and
     swingRange <= consRange * maxExpansion

rangeAverage = ta.sma(high - low, atrLookback)

rangeCompression =
     not na(rangeAverage) and
     rangeAverage > 0 and
     (high - low) <= rangeAverage * 1.20

compressionScore =
     (priceCompression ? 1 : 0) +
     (atrCompression ? 1 : 0) +
     (swingContained ? 1 : 0) +
     (rangeCompression ? 1 : 0)

isQualityConsolidation =
     priceCompression and
     compressionScore >= 3


//====================================================================
// STATE MACHINE
//
// 0 = Waiting
// 1 = Consolidation
// 2 = Acceptance Watch
// 3 = Retest Watch
//====================================================================

var int setupState = 0

var int boxStartBar = na
var int boxAge = 0

var float resistance = na
var float support = na

var int breakoutDirection = 0
var int breakoutBar = na

var float breakoutPrice = na
var float breakoutVolume = na
var float breakoutATR = na

var int acceptanceBarsSeen = 0

var box consBox = na

var line resistanceLine = na
var line supportLine = na

var line entryLine = na


//====================================================================
// START CONSOLIDATION
//====================================================================

if setupState == 0 and isQualityConsolidation

    setupState := 1

    boxStartBar := bar_index
    boxAge := 0

    resistance := recentHigh
    support := recentLow

    breakoutDirection := 0
    breakoutBar := na

    breakoutPrice := na
    breakoutVolume := na
    breakoutATR := na

    acceptanceBarsSeen := 0

    if showBox

        consBox := box.new(
             left=bar_index,
             top=resistance,
             right=bar_index,
             bottom=support,
             bgcolor=color.new(color.purple, 88),
             border_color=color.new(color.purple, 25))


    if showLevels

        resistanceLine := line.new(
             bar_index,
             resistance,
             bar_index,
             resistance,
             color=color.new(color.red, 20),
             width=1)

        supportLine := line.new(
             bar_index,
             support,
             bar_index,
             support,
             color=color.new(color.green, 20),
             width=1)


//====================================================================
// ACTIVE CONSOLIDATION
//====================================================================

if setupState == 1

    boxAge += 1

    if showBox and not na(consBox)

        box.set_right(
             consBox,
             bar_index)

    if showLevels

        if not na(resistanceLine)

            line.set_x2(
                 resistanceLine,
                 bar_index)

        if not na(supportLine)

            line.set_x2(
                 supportLine,
                 bar_index)


//====================================================================
// CONSOLIDATION TIMEOUT
//====================================================================

if setupState == 1 and boxAge > maxConsBars

    setupState := 0

    if not na(consBox)

        box.delete(consBox)
        consBox := na

    if not na(resistanceLine)

        line.delete(resistanceLine)
        resistanceLine := na

    if not na(supportLine)

        line.delete(supportLine)
        supportLine := na


//====================================================================
// BREAKOUT QUALITY CALCULATIONS
//====================================================================

candleRange = high - low

body = math.abs(close - open)

bodyRatio =
     candleRange > 0
     ? body / candleRange
     : 0

bodyATR =
     atr > 0
     ? body / atr
     : 0

bullCloseLocation =
     candleRange > 0
     ? (close - low) / candleRange
     : 0

bearCloseLocation =
     candleRange > 0
     ? (high - close) / candleRange
     : 0


averageVolume = ta.sma(volume, volumeLength)[1]

relativeVolume =
     not na(averageVolume) and averageVolume > 0
     ? volume / averageVolume
     : 0


volumeQuality =
     not useVolume or relativeVolume >= volumeMult


bullBodyQuality =
     close > open and
     bodyRatio >= minBodyRatio


bearBodyQuality =
     close < open and
     bodyRatio >= minBodyRatio


bullCloseQuality =
     bullCloseLocation >= minCloseLoc


bearCloseQuality =
     bearCloseLocation >= minCloseLoc


displacementQuality =
     bodyATR >= minBodyATR


bullStructureQuality =
     trend == 1


bearStructureQuality =
     trend == -1


notExhausted =
     bodyATR <= maxBreakoutATR


bullScore =
     (bullBodyQuality ? 1 : 0) +
     (bullCloseQuality ? 1 : 0) +
     (displacementQuality ? 1 : 0) +
     (volumeQuality ? 1 : 0) +
     (bullStructureQuality ? 1 : 0)


bearScore =
     (bearBodyQuality ? 1 : 0) +
     (bearCloseQuality ? 1 : 0) +
     (displacementQuality ? 1 : 0) +
     (volumeQuality ? 1 : 0) +
     (bearStructureQuality ? 1 : 0)


//====================================================================
// LEVEL BREAK
//====================================================================

bullLevelBreak =
     setupState == 1 and
     close > resistance *
     (1 + breakoutBuffer / 100)

bearLevelBreak =
     setupState == 1 and
     close < support *
     (1 - breakoutBuffer / 100)


//====================================================================
// FINAL BREAKOUT
//====================================================================

bullBreakout =
     bullLevelBreak and
     bullScore >= minBreakoutScore and
     notExhausted

bearBreakout =
     bearLevelBreak and
     bearScore >= minBreakoutScore and
     notExhausted


//====================================================================
// BREAKOUT → ACCEPTANCE WATCH
//
// IMPORTANT:
// The breakout candle NEVER becomes accepted here.
// We only enter Acceptance Watch.
//====================================================================

if bullBreakout

    setupState := 2

    breakoutDirection := 1
    breakoutBar := bar_index

    breakoutPrice := close
    breakoutVolume := volume
    breakoutATR := atr

    acceptanceBarsSeen := 0

    if showBreakout

        label.new(
             bar_index,
             low,
             "BREAKOUT\nLONG " +
             str.tostring(bullScore) +
             "/5",
             style=label.style_label_up,
             color=color.new(color.green, 0),
             textcolor=color.white,
             size=size.small)


if bearBreakout

    setupState := 2

    breakoutDirection := -1
    breakoutBar := bar_index

    breakoutPrice := close
    breakoutVolume := volume
    breakoutATR := atr

    acceptanceBarsSeen := 0

    if showBreakout

        label.new(
             bar_index,
             high,
             "BREAKOUT\nSHORT " +
             str.tostring(bearScore) +
             "/5",
             style=label.style_label_down,
             color=color.new(color.red, 0),
             textcolor=color.white,
             size=size.small)


//====================================================================
// ACCEPTANCE ENGINE
//====================================================================

bool acceptanceConfirmed = false
bool acceptanceFailed = false

if setupState == 2 and bar_index > breakoutBar

    acceptanceBarsSeen += 1

    //────────────────────────────────────────
    // COMMON CANDLE METRICS
    //────────────────────────────────────────

    currentBody = math.abs(close - open)

    currentBodyATR =
         atr > 0
         ? currentBody / atr
         : 0

    currentRange = high - low

    upperWick =
         high - math.max(open, close)

    lowerWick =
         math.min(open, close) - low

    upperWickRatio =
         currentRange > 0
         ? upperWick / currentRange
         : 0

    lowerWickRatio =
         currentRange > 0
         ? lowerWick / currentRange
         : 0


    //────────────────────────────────────────
    // BULLISH ACCEPTANCE
    //────────────────────────────────────────

    if breakoutDirection == 1

        //------------------------------------------------------------
        // 1. HOLD LEVEL
        //------------------------------------------------------------

        holdLevel =
             close > resistance

        //------------------------------------------------------------
        // 2. CLOSE QUALITY
        //------------------------------------------------------------

        bullCloseQualityNow =
             close > resistance and
             close > open

        //------------------------------------------------------------
        // 3. FOLLOW-THROUGH
        //------------------------------------------------------------

        followThrough =
             close > resistance and
             currentBodyATR >= acceptanceBodyATR

        //------------------------------------------------------------
        // 4. MOMENTUM
        //------------------------------------------------------------

        momentumHealthy =
             close >= breakoutPrice or
             currentBodyATR >= acceptanceBodyATR

        //------------------------------------------------------------
        // 5. VOLUME BEHAVIOR
        //------------------------------------------------------------

        volumeBehavior =
             not useVolume or
             volume >= breakoutVolume * minVolumeRetention

        //------------------------------------------------------------
        // 6. REJECTION QUALITY
        //
        // Large upper wick after bullish breakout is a warning.
        //------------------------------------------------------------

        rejectionHealthy =
             upperWickRatio <= maxRejectionWick

        //------------------------------------------------------------
        // 7. RETRACEMENT
        //
        // Don't allow price to travel decisively back through
        // the broken level.
        //------------------------------------------------------------

        retracementLimit =
             resistance *
             (1 - maxAcceptanceRetrace / 100)

        retracementHealthy =
             low >= retracementLimit or
             close > resistance

        //------------------------------------------------------------
        // FAILURE DETECTION
        //------------------------------------------------------------

        closedInsideBox =
             close <= resistance

        strongOppositeCandle =
             close < open and
             currentBodyATR >= oppositeBodyATR

        failedLevelFlip =
             close < resistance

        excessiveRetracement =
             low < retracementLimit and
             close < resistance

        acceptanceFailed :=
             closedInsideBox or
             strongOppositeCandle or
             excessiveRetracement

        //------------------------------------------------------------
        // ACCEPTANCE SCORE
        //
        // Hold is mandatory.
        // Other evidence contributes to quality.
        //------------------------------------------------------------

        bullAcceptanceScore =
             (holdLevel ? 1 : 0) +
             (bullCloseQualityNow ? 1 : 0) +
             (followThrough ? 1 : 0) +
             (momentumHealthy ? 1 : 0) +
             (volumeBehavior and rejectionHealthy ? 1 : 0)

        //------------------------------------------------------------
        // ACCEPT
        //------------------------------------------------------------

        acceptanceConfirmed :=
             not acceptanceFailed and
             holdLevel and
             acceptanceBarsSeen >= acceptanceWatchBars and
             bullAcceptanceScore >= minAcceptanceScore


        //------------------------------------------------------------
        // BULLISH FAILURE
        //------------------------------------------------------------

        if acceptanceFailed

            if showAcceptance

                label.new(
                     bar_index,
                     high,
                     "ACCEPTANCE FAILED",
                     style=label.style_label_down,
                     color=color.gray,
                     textcolor=color.white,
                     size=size.tiny)

            setupState := 0
            breakoutDirection := 0
            acceptanceBarsSeen := 0


    //────────────────────────────────────────
    // BEARISH ACCEPTANCE
    //────────────────────────────────────────

    if breakoutDirection == -1

        //------------------------------------------------------------
        // 1. HOLD LEVEL
        //------------------------------------------------------------

        holdLevel =
             close < support

        //------------------------------------------------------------
        // 2. CLOSE QUALITY
        //------------------------------------------------------------

        bearCloseQualityNow =
             close < support and
             close < open

        //------------------------------------------------------------
        // 3. FOLLOW-THROUGH
        //------------------------------------------------------------

        followThrough =
             close < support and
             currentBodyATR >= acceptanceBodyATR

        //------------------------------------------------------------
        // 4. MOMENTUM
        //------------------------------------------------------------

        momentumHealthy =
             close <= breakoutPrice or
             currentBodyATR >= acceptanceBodyATR

        //------------------------------------------------------------
        // 5. VOLUME BEHAVIOR
        //------------------------------------------------------------

        volumeBehavior =
             not useVolume or
             volume >= breakoutVolume * minVolumeRetention

        //------------------------------------------------------------
        // 6. REJECTION QUALITY
        //------------------------------------------------------------

        rejectionHealthy =
             lowerWickRatio <= maxRejectionWick

        //------------------------------------------------------------
        // 7. RETRACEMENT
        //------------------------------------------------------------

        retracementLimit =
             support *
             (1 + maxAcceptanceRetrace / 100)

        retracementHealthy =
             high <= retracementLimit or
             close < support

        //------------------------------------------------------------
        // FAILURE DETECTION
        //------------------------------------------------------------

        closedInsideBox =
             close >= support

        strongOppositeCandle =
             close > open and
             currentBodyATR >= oppositeBodyATR

        failedLevelFlip =
             close > support

        excessiveRetracement =
             high > retracementLimit and
             close > support

        acceptanceFailed :=
             closedInsideBox or
             strongOppositeCandle or
             excessiveRetracement

        //------------------------------------------------------------
        // ACCEPTANCE SCORE
        //------------------------------------------------------------

        bearAcceptanceScore =
             (holdLevel ? 1 : 0) +
             (bearCloseQualityNow ? 1 : 0) +
             (followThrough ? 1 : 0) +
             (momentumHealthy ? 1 : 0) +
             (volumeBehavior and rejectionHealthy ? 1 : 0)

        //------------------------------------------------------------
        // ACCEPT
        //------------------------------------------------------------

        acceptanceConfirmed :=
             not acceptanceFailed and
             holdLevel and
             acceptanceBarsSeen >= acceptanceWatchBars and
             bearAcceptanceScore >= minAcceptanceScore


        //------------------------------------------------------------
        // BEARISH FAILURE
        //------------------------------------------------------------

        if acceptanceFailed

            if showAcceptance

                label.new(
                     bar_index,
                     low,
                     "ACCEPTANCE FAILED",
                     style=label.style_label_up,
                     color=color.gray,
                     textcolor=color.white,
                     size=size.tiny)

            setupState := 0
            breakoutDirection := 0
            acceptanceBarsSeen := 0


//====================================================================
// ACCEPTED → RETEST WATCH
//====================================================================

if acceptanceConfirmed

    setupState := 3

    if showAcceptance

        if breakoutDirection == 1

            label.new(
                 bar_index,
                 low,
                 "ACCEPTED ✓",
                 style=label.style_label_up,
                 color=color.new(color.blue, 0),
                 textcolor=color.white,
                 size=size.small)

        else if breakoutDirection == -1

            label.new(
                 bar_index,
                 high,
                 "ACCEPTED ✓",
                 style=label.style_label_down,
                 color=color.new(color.blue, 0),
                 textcolor=color.white,
                 size=size.small)


//====================================================================
// RETEST ENGINE
//
// Intentionally kept simple for now.
// We will upgrade this AFTER acceptance is validated.
//====================================================================

var int retestCount = 0

if setupState == 3

    retestCount += 1

    //────────────────────────────────────────
    // LONG RETEST
    //────────────────────────────────────────

    if breakoutDirection == 1

        bullishRetestTouched =
             low <= resistance *
             (1 + retestBuffer / 100)

        bullishRetestHeld =
             close > resistance

        bullishRetest =
             bullishRetestTouched and
             bullishRetestHeld

        if bullishRetest

            if showRetest

                label.new(
                     bar_index,
                     low,
                     "RETEST",
                     style=label.style_label_up,
                     color=color.new(color.orange, 0),
                     textcolor=color.white,
                     size=size.tiny)

            if showEntry

                label.new(
                     bar_index,
                     close,
                     "LONG ENTRY",
                     style=label.style_label_up,
                     color=color.new(color.green, 0),
                     textcolor=color.white,
                     size=size.small)

                entryLine := line.new(
                     bar_index,
                     close,
                     bar_index + 5,
                     close,
                     color=color.new(color.green, 0),
                     width=2)

            setupState := 0
            breakoutDirection := 0
            retestCount := 0


    //────────────────────────────────────────
    // SHORT RETEST
    //────────────────────────────────────────

    else if breakoutDirection == -1

        bearishRetestTouched =
             high >= support *
             (1 - retestBuffer / 100)

        bearishRetestHeld =
             close < support

        bearishRetest =
             bearishRetestTouched and
             bearishRetestHeld

        if bearishRetest

            if showRetest

                label.new(
                     bar_index,
                     high,
                     "RETEST",
                     style=label.style_label_down,
                     color=color.new(color.orange, 0),
                     textcolor=color.white,
                     size=size.tiny)

            if showEntry

                label.new(
                     bar_index,
                     close,
                     "SHORT ENTRY",
                     style=label.style_label_down,
                     color=color.new(color.red, 0),
                     textcolor=color.white,
                     size=size.small)

                entryLine := line.new(
                     bar_index,
                     close,
                     bar_index + 5,
                     close,
                     color=color.new(color.red, 0),
                     width=2)

            setupState := 0
            breakoutDirection := 0
            retestCount := 0


//====================================================================
// RETEST TIMEOUT
//====================================================================

if setupState == 3 and retestCount > retestBars

    setupState := 0
    breakoutDirection := 0
    retestCount := 0


//====================================================================
// ALERTS
//====================================================================

alertcondition(
     bullBreakout,
     title="Bullish Breakout",
     message="Bullish breakout detected — Acceptance Watch started.")

alertcondition(
     bearBreakout,
     title="Bearish Breakout",
     message="Bearish breakout detected — Acceptance Watch started.")

alertcondition(
     acceptanceConfirmed and breakoutDirection == 1,
     title="Bullish Breakout Accepted",
     message="Bullish breakout accepted — waiting for retest.")

alertcondition(
     acceptanceConfirmed and breakoutDirection == -1,
     title="Bearish Breakout Accepted",
     message="Bearish breakout accepted — waiting for retest.")
