//@version=6
strategy("V2 Confluence Engine — High R:R + Strong Confirmation",
     overlay=true,
     pyramiding=0,
     initial_capital=100000,
     commission_type=strategy.commission.percent,
     commission_value=0.05,
     process_orders_on_close=true,
     calc_on_order_fills=true)

//──────────────────────────────────────────────────────────────────────────────
// V2 — 15M primary framework
// Designed for NIFTY and US stocks.
// Default profile: High R:R + Strong Confirmation.
// This is a rules-based technical engine, not a profitability guarantee.
//──────────────────────────────────────────────────────────────────────────────

// === Inputs
groupCore = "01 • Core"
minScore       = input.int(14, "Minimum confluence score", minval=8, maxval=20, group=groupCore)
minRR          = input.float(2.0, "Minimum R:R", minval=1.0, step=0.25, group=groupCore)
primaryTF      = input.timeframe("15", "Primary setup timeframe", group=groupCore)
htf            = input.timeframe("60", "Higher timeframe", group=groupCore)
confirmTF      = input.timeframe("5", "Confirmation timeframe", group=groupCore)
useSession     = input.bool(true, "Use regular-session filter", group=groupCore)

groupTrend = "02 • Trend / Structure"
fastLen        = input.int(20, "Fast EMA", minval=2, group=groupTrend)
slowLen        = input.int(50, "Slow EMA", minval=3, group=groupTrend)
structureLen   = input.int(20, "Structure lookback", minval=5, group=groupTrend)

groupMomentum = "03 • Momentum"
rsiLen         = input.int(14, "RSI length", minval=2, group=groupMomentum)
adxLen         = input.int(14, "ADX length", minval=2, group=groupMomentum)
adxMin         = input.float(18, "ADX minimum", minval=5, step=1, group=groupMomentum)

groupRelative = "04 • Relative Strength"
benchmark      = input.symbol("NSE:NIFTY", "Benchmark", group=groupRelative)
sectorSymbol   = input.symbol("NSE:NIFTY_BANK", "Sector / comparison symbol", group=groupRelative)
rsLen          = input.int(20, "RS lookback", minval=2, group=groupRelative)

groupVWAP = "05 • VWAP"
useVWAP         = input.bool(true, "Use VWAP filter", group=groupVWAP)
useAnchoredVWAP = input.bool(false, "Use anchored VWAP proxy", group=groupVWAP)
anchorLen       = input.int(50, "Anchored VWAP proxy length", minval=5, group=groupVWAP)

groupVolume = "06 • Volume"
volLen         = input.int(20, "Relative-volume lookback", minval=2, group=groupVolume)
volMultiplier  = input.float(1.10, "Confirmation volume multiplier", minval=0.5, step=0.05, group=groupVolume)

groupRisk = "07 • Risk / Targets"
atrLen          = input.int(14, "ATR length", minval=2, group=groupRisk)
stopATR         = input.float(1.0, "Minimum ATR stop component", minval=0.25, step=0.25, group=groupRisk)
swingLen       = input.int(10, "Swing stop lookback", minval=2, group=groupRisk)
targetR1        = input.float(2.0, "T1 R multiple", minval=0.5, step=0.25, group=groupRisk)
targetR2        = input.float(3.0, "T2 R multiple", minval=1.0, step=0.25, group=groupRisk)

groupOpening = "08 • Opening / Liquidity"
openingMinutes = input.int(15, "Opening range minutes", minval=5, maxval=60, group=groupOpening)
sweepLen       = input.int(10, "Liquidity sweep lookback", minval=2, group=groupOpening)

groupDarvas = "09 • Optional Darvas"
useDarvas      = input.bool(false, "Use Darvas as secondary evidence", group=groupDarvas)
darvasLen      = input.int(20, "Darvas lookback", minval=5, group=groupDarvas)

// === Helpers
f_safeDiv(a, b) =>
    b == 0.0 ? 0.0 : a / b

// === Timeframe gate
isPrimary = timeframe.period == primaryTF

// === Trend regime
emaFast = ta.ema(close, fastLen)
emaSlow = ta.ema(close, slowLen)
htfClose = request.security(syminfo.tickerid, htf, close, lookahead=barmerge.lookahead_off)
htfFast  = request.security(syminfo.tickerid, htf, ta.ema(close, fastLen), lookahead=barmerge.lookahead_off)
htfSlow  = request.security(syminfo.tickerid, htf, ta.ema(close, slowLen), lookahead=barmerge.lookahead_off)

bullTrend = close > emaFast and emaFast > emaSlow
bearTrend = close < emaFast and emaFast < emaSlow
htfBull   = htfClose > htfFast and htfFast > htfSlow
htfBear   = htfClose < htfFast and htfFast < htfSlow

hh = high > ta.highest(high[1], structureLen)
ll = low < ta.lowest(low[1], structureLen)
bullStructure = close > ta.highest(high[1], structureLen)
bearStructure = close < ta.lowest(low[1], structureLen)

// === Momentum
rsi = ta.rsi(close, rsiLen)
[diPlus, diMinus, adx] = ta.dmi(adxLen, adxLen)

bullMomentum = rsi > 52 and diPlus > diMinus and adx >= adxMin
bearMomentum = rsi < 48 and diMinus > diPlus and adx >= adxMin

// === Relative strength
benchClose = request.security(benchmark, timeframe.period, close, lookahead=barmerge.lookahead_off)
sectorClose = request.security(sectorSymbol, timeframe.period, close, lookahead=barmerge.lookahead_off)

stockROC  = ta.roc(close, rsLen)
benchROC  = ta.roc(benchClose, rsLen)
sectorROC = ta.roc(sectorClose, rsLen)

rsBull = stockROC > benchROC and stockROC > sectorROC
rsBear = stockROC < benchROC and stockROC < sectorROC

// === VWAP
vwapValue = ta.vwap(hlc3)
anchoredProxy = ta.vwma(hlc3, anchorLen)

aboveVWAP = close > vwapValue
belowVWAP = close < vwapValue

vwapBull = aboveVWAP and vwapValue >= vwapValue[1]
vwapBear = belowVWAP and vwapValue <= vwapValue[1]

avwapBull = close > anchoredProxy
avwapBear = close < anchoredProxy

// === Volume
volAvg = ta.sma(volume, volLen)
relVol = f_safeDiv(volume, volAvg)
volumeBull = close > open and relVol >= volMultiplier
volumeBear = close < open and relVol >= volMultiplier

// === ATR / volatility
atr = ta.atr(atrLen)

// === Previous day levels
prevHigh = request.security(syminfo.tickerid, "D", high[1], lookahead=barmerge.lookahead_off)
prevLow  = request.security(syminfo.tickerid, "D", low[1], lookahead=barmerge.lookahead_off)
prevClose = request.security(syminfo.tickerid, "D", close[1], lookahead=barmerge.lookahead_off)

// === Opening range (first N minutes of regular session)
// Uses session-day reset; exchange session settings come from the chart symbol.
newDay = ta.change(time("D")) != 0
var float orHigh = na
var float orLow = na
var int dayStart = na

if newDay
    orHigh := high
    orLow := low
    dayStart := time
else
    if not na(dayStart) and (time - dayStart) < openingMinutes * 60 * 1000
        orHigh := math.max(nz(orHigh, high), high)
        orLow := math.min(nz(orLow, low), low)

orReady = not na(orHigh) and not na(orLow) and not na(dayStart) and (time - dayStart) >= openingMinutes * 60 * 1000

// === Liquidity sweep proxies
priorHigh = ta.highest(high[1], sweepLen)
priorLow  = ta.lowest(low[1], sweepLen)

bullSweep = low < priorLow and close > priorLow
bearSweep = high > priorHigh and close < priorHigh

// === Breakout / breakdown confirmation
breakoutLevel = ta.highest(high[1], structureLen)
breakdownLevel = ta.lowest(low[1], structureLen)

bullBreak = close > breakoutLevel
bearBreak = close < breakdownLevel

// Acceptance proxy: two consecutive closes beyond level, plus volume.
bullAcceptance = bullBreak and close[1] > breakoutLevel[1] and volumeBull
bearAcceptance = bearBreak and close[1] < breakdownLevel[1] and volumeBear

// Retest proxy: current bar tests the broken level and closes back in direction.
bullRetest = bullBreak[1] and low <= breakoutLevel[1] and close > breakoutLevel[1]
bearRetest = bearBreak[1] and high >= breakdownLevel[1] and close < breakdownLevel[1]

// === Optional Darvas secondary evidence
darvasHigh = ta.highest(high, darvasLen)
darvasLow  = ta.lowest(low, darvasLen)
darvasBull = useDarvas and close > darvasHigh[1]
darvasBear = useDarvas and close < darvasLow[1]

// === Confirmation timeframe
confirmClose = request.security(syminfo.tickerid, confirmTF, close, lookahead=barmerge.lookahead_off)
confirmVWAP  = request.security(syminfo.tickerid, confirmTF, ta.vwap(hlc3), lookahead=barmerge.lookahead_off)
confirmBull = confirmClose > confirmVWAP
confirmBear = confirmClose < confirmVWAP

// === Opening-session filter
inRegularSession = not useSession or session.ismarket

// === Confluence scoring
// Max practical score is 20. Darvas is secondary and replaces no core condition.
int bullScore = 0
int bearScore = 0

bullScore += bullTrend ? 2 : 0
bullScore += htfBull ? 2 : 0
bullScore += bullMomentum ? 2 : 0
bullScore += rsBull ? 2 : 0
bullScore += vwapBull ? 2 : 0
bullScore += volumeBull ? 2 : 0
bullScore += (bullStructure or bullAcceptance or bullRetest) ? 2 : 0
bullScore += confirmBull ? 2 : 0
bullScore += (bullSweep or (orReady and close > orHigh)) ? 1 : 0
bullScore += (useDarvas and darvasBull) ? 1 : 0

bearScore += bearTrend ? 2 : 0
bearScore += htfBear ? 2 : 0
bearScore += bearMomentum ? 2 : 0
bearScore += rsBear ? 2 : 0
bearScore += vwapBear ? 2 : 0
bearScore += volumeBear ? 2 : 0
bearScore += (bearStructure or bearAcceptance or bearRetest) ? 2 : 0
bearScore += confirmBear ? 2 : 0
bearScore += (bearSweep or (orReady and close < orLow)) ? 1 : 0
bearScore += (useDarvas and darvasBear) ? 1 : 0

// === Structural trade levels
longStop = math.min(ta.lowest(low, swingLen), close - atr * stopATR)
shortStop = math.max(ta.highest(high, swingLen), close + atr * stopATR)

longRisk = close - longStop
shortRisk = shortStop - close

longT1 = close + longRisk * targetR1
longT2 = close + longRisk * targetR2
shortT1 = close - shortRisk * targetR1
shortT2 = close - shortRisk * targetR2

longRR = f_safeDiv(longT2 - close, longRisk)
shortRR = f_safeDiv(close - shortT2, shortRisk)

// === High-R:R + strong confirmation triggers
// Primary timeframe is required for entries.
longConfirmation = bullAcceptance or bullRetest or (bullBreak and volumeBull and confirmBull)
shortConfirmation = bearAcceptance or bearRetest or (bearBreak and volumeBear and confirmBear)

longSetup = isPrimary and inRegularSession and bullScore >= minScore and longConfirmation and longRR >= minRR and htfBull and bullTrend
shortSetup = isPrimary and inRegularSession and bearScore >= minScore and shortConfirmation and shortRR >= minRR and htfBear and bearTrend

// Prevent simultaneous opposite signals.
longSignal = longSetup and not shortSetup
shortSignal = shortSetup and not longSetup

// === Orders
if longSignal and strategy.position_size <= 0
    strategy.entry("LONG", strategy.long)

if shortSignal and strategy.position_size >= 0
    strategy.entry("SHORT", strategy.short)

// Dynamic exits based on signal-time structure.
// Using strategy.position_avg_price after entry keeps levels tied to actual fills.
activeLongStop = strategy.position_size > 0 ? math.min(ta.lowest(low, swingLen), strategy.position_avg_price - atr * stopATR) : na
activeShortStop = strategy.position_size < 0 ? math.max(ta.highest(high, swingLen), strategy.position_avg_price + atr * stopATR) : na

longRiskLive = strategy.position_size > 0 ? strategy.position_avg_price - activeLongStop : na
shortRiskLive = strategy.position_size < 0 ? activeShortStop - strategy.position_avg_price : na

liveLongT1 = strategy.position_size > 0 ? strategy.position_avg_price + longRiskLive * targetR1 : na
liveLongT2 = strategy.position_size > 0 ? strategy.position_avg_price + longRiskLive * targetR2 : na
liveShortT1 = strategy.position_size < 0 ? strategy.position_avg_price - shortRiskLive * targetR1 : na
liveShortT2 = strategy.position_size < 0 ? strategy.position_avg_price - shortRiskLive * targetR2 : na

if strategy.position_size > 0
    strategy.exit("L-T1", "LONG", stop=activeLongStop, limit=liveLongT1, qty_percent=50)
    strategy.exit("L-T2", "LONG", stop=activeLongStop, limit=liveLongT2, qty_percent=50)

if strategy.position_size < 0
    strategy.exit("S-T1", "SHORT", stop=activeShortStop, limit=liveShortT1, qty_percent=50)
    strategy.exit("S-T2", "SHORT", stop=activeShortStop, limit=liveShortT2, qty_percent=50)

// === Visuals
plot(emaFast, "Fast EMA", linewidth=2)
plot(emaSlow, "Slow EMA", linewidth=2)
plot(useVWAP ? vwapValue : na, "VWAP", linewidth=2)
plot(useAnchoredVWAP ? anchoredProxy : na, "Anchored VWAP proxy", linewidth=2)

plot(prevHigh, "Previous Day High", style=plot.style_linebr)
plot(prevLow, "Previous Day Low", style=plot.style_linebr)
plot(orReady ? orHigh : na, "Opening Range High", style=plot.style_linebr)
plot(orReady ? orLow : na, "Opening Range Low", style=plot.style_linebr)

plotshape(longSignal, title="LONG confirmation", style=shape.triangleup, location=location.belowbar, size=size.small, text="LONG")
plotshape(shortSignal, title="SHORT confirmation", style=shape.triangledown, location=location.abovebar, size=size.small, text="SHORT")

// === Dashboard
var table dash = table.new(position.top_right, 3, 17)

regimeText = htfBull and bullTrend ? "BULLISH" : htfBear and bearTrend ? "BEARISH" : "RANGE / TRANSITION"
regimeScore = math.max(bullScore, bearScore)
dominant = bullScore > bearScore ? "BULLISH" : bearScore > bullScore ? "BEARISH" : "MIXED"

if barstate.islast
    table.cell(dash, 0, 0, "V2 CONFLUENCE ENGINE")
    table.cell(dash, 1, 0, syminfo.ticker)
    table.cell(dash, 2, 0, "15M")

    table.cell(dash, 0, 1, "REGIME")
    table.cell(dash, 1, 1, regimeText)
    table.cell(dash, 2, 1, str.tostring(regimeScore) + "/20")

    table.cell(dash, 0, 2, "TREND")
    table.cell(dash, 1, 2, bullTrend ? "BULL" : bearTrend ? "BEAR" : "MIXED")
    table.cell(dash, 2, 2, htfBull ? "HTF BULL" : htfBear ? "HTF BEAR" : "HTF MIXED")

    table.cell(dash, 0, 3, "MOMENTUM")
    table.cell(dash, 1, 3, bullMomentum ? "BULL" : bearMomentum ? "BEAR" : "WEAK/MIXED")
    table.cell(dash, 2, 3, "RSI " + str.tostring(rsi, "#.0"))

    table.cell(dash, 0, 4, "REL STRENGTH")
    table.cell(dash, 1, 4, rsBull ? "STRONG" : rsBear ? "WEAK" : "MIXED")
    table.cell(dash, 2, 4, str.tostring(stockROC, "#.1") + "%")

    table.cell(dash, 0, 5, "VWAP")
    table.cell(dash, 1, 5, aboveVWAP ? "ABOVE" : "BELOW")
    table.cell(dash, 2, 5, "RS " + str.tostring(relVol, "#.2"))

    table.cell(dash, 0, 6, "VOLUME")
    table.cell(dash, 1, 6, relVol >= volMultiplier ? "CONFIRMING" : "NORMAL/WEAK")
    table.cell(dash, 2, 6, str.tostring(relVol, "#.2") + "x")

    table.cell(dash, 0, 7, "BREAKOUT")
    table.cell(dash, 1, 7, bullAcceptance ? "BULL CONF" : bearAcceptance ? "BEAR CONF" : "NONE")
    table.cell(dash, 2, 7, bullRetest ? "BULL RETEST" : bearRetest ? "BEAR RETEST" : "WAIT")

    table.cell(dash, 0, 8, "CONFIRM TF")
    table.cell(dash, 1, 8, confirmBull ? "BULL" : confirmBear ? "BEAR" : "MIXED")
    table.cell(dash, 2, 8, confirmTF)

    table.cell(dash, 0, 9, "BULL SCORE")
    table.cell(dash, 1, 9, str.tostring(bullScore) + "/20")
    table.cell(dash, 2, 9, bullScore >= minScore ? "QUALIFIED" : "WAIT")

    table.cell(dash, 0, 10, "BEAR SCORE")
    table.cell(dash, 1, 10, str.tostring(bearScore) + "/20")
    table.cell(dash, 2, 10, bearScore >= minScore ? "QUALIFIED" : "WAIT")

    table.cell(dash, 0, 11, "A SAFEST")
    table.cell(dash, 1, 11, longSignal ? "LONG" : shortSignal ? "SHORT" : "WAIT")
    table.cell(dash, 2, 11, "Strongest confirm")

    table.cell(dash, 0, 12, "B HIGH R:R")
    table.cell(dash, 1, 12, longSignal ? "LONG" : shortSignal ? "SHORT" : "WAIT")
    table.cell(dash, 2, 12, "DEFAULT")

    table.cell(dash, 0, 13, "C BALANCED")
    table.cell(dash, 1, 13, dominant)
    table.cell(dash, 2, 13, "WAIT/CONFIRM")

    table.cell(dash, 0, 14, "TRADE")
    table.cell(dash, 1, 14, longSignal ? "LONG" : shortSignal ? "SHORT" : "WAIT")
    table.cell(dash, 2, 14, "Min R:R " + str.tostring(minRR, "#.##"))

    table.cell(dash, 0, 15, "LEVELS")
    table.cell(dash, 1, 15, longSignal ? "SL " + str.tostring(longStop, format.mintick) : shortSignal ? "SL " + str.tostring(shortStop, format.mintick) : "—")
    table.cell(dash, 2, 15, longSignal ? "T2 " + str.tostring(longT2, format.mintick) : shortSignal ? "T2 " + str.tostring(shortT2, format.mintick) : "—")

    table.cell(dash, 0, 16, "STATUS")
    table.cell(dash, 1, 16, longSignal ? "LONG CONFIRMED" : shortSignal ? "SHORT CONFIRMED" : "WAIT")
    table.cell(dash, 2, 16, "No chase")

// === Alerts
alertcondition(longSignal, "V2 LONG CONFIRMED", "V2 High R:R + Strong Confirmation LONG on {{ticker}} {{interval}}")
alertcondition(shortSignal, "V2 SHORT CONFIRMED", "V2 High R:R + Strong Confirmation SHORT on {{ticker}} {{interval}}")
alertcondition(not longSignal and not shortSignal and bullScore >= minScore and bearScore >= minScore, "V2 CONFLICT / WAIT", "V2 conflict: both directions qualified; WAIT on {{ticker}}")
