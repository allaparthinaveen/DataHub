//@version=6
strategy("V3 Clean Confluence — Higher Win Rate (US Stocks)",
     overlay=true,
     pyramiding=0,
     initial_capital=100000,
     commission_type=strategy.commission.percent,
     commission_value=0.05,
     process_orders_on_close=true,
     calc_on_order_fills=true,
     max_labels_count=100,
     default_qty_type=strategy.cash,
     default_qty_value=0)

// ============================================================================
// HIGHER WIN-RATE EDITION
// Target: 45-50% win rate | Profit Factor > 1.2
// ============================================================================

// ── Engine
minScore   = input.int(10, "Minimum confluence score", minval=7, maxval=18, group="Engine")
minRR      = input.float(1.8, "Minimum R:R to T2", minval=1.2, step=0.1, group="Engine")
primaryTF  = input.timeframe("15", "Primary setup timeframe", group="Engine")
htf        = input.timeframe("60", "Higher timeframe", group="Engine")
confirmTF  = input.timeframe("5", "Confirmation timeframe", group="Engine")
useSession = input.bool(true, "Trade only US Regular Hours (9:30-16:00 ET)", group="Engine")

// ── Trend
fastLen    = input.int(20, "Fast EMA", minval=2, group="Trend")
slowLen    = input.int(50, "Slow EMA", minval=3, group="Trend")
structureLen = input.int(20, "Structure lookback", minval=5, group="Trend")

// ── Momentum
rsiLen     = input.int(14, "RSI length", minval=2, group="Momentum")
adxLen     = input.int(14, "ADX length", minval=2, group="Momentum")
adxMin     = input.float(16, "ADX minimum", minval=5, step=1, group="Momentum")

// ── Relative Strength
useRS          = input.bool(true, "Use Relative Strength filter", group="Relative Strength")
benchmark      = input.symbol("SPY", "Benchmark", group="Relative Strength")
sectorSymbol   = input.symbol("XLK", "Sector benchmark", group="Relative Strength")
rsLen          = input.int(20, "RS lookback", minval=2, group="Relative Strength")

// ── Volume
volLen         = input.int(20, "Volume average", minval=2, group="Volume")
volMultiplier  = input.float(1.05, "Confirmation volume multiplier", minval=0.5, step=0.05, group="Volume")

// ── Risk (tuned for higher win rate)
atrLen         = input.int(14, "ATR length", minval=2, group="Risk")
stopATR        = input.float(0.8, "ATR stop component", minval=0.3, step=0.1, group="Risk")
swingLen       = input.int(8, "Swing stop lookback", minval=2, group="Risk")
targetR1       = input.float(1.5, "T1 R multiple", minval=0.8, step=0.1, group="Risk")
targetR2       = input.float(2.5, "T2 R multiple", minval=1.5, step=0.1, group="Risk")
riskPercent    = input.float(0.7, "Risk % of equity per trade", minval=0.1, maxval=2.5, step=0.05, group="Risk")
trailAfterT1   = input.bool(true, "Trail remaining 50% after T1", group="Risk")
trailATRmult   = input.float(1.3, "Trail ATR multiplier (after BE)", minval=0.5, step=0.1, group="Risk")

// ── Optional
useDarvas      = input.bool(false, "Use Darvas as secondary evidence", group="Optional")
darvasLen      = input.int(20, "Darvas lookback", minval=5, group="Optional")

f_safeDiv(a, b) => b == 0.0 ? 0.0 : a / b
isPrimary = timeframe.period == primaryTF

// US Regular session (New York time)
inSession = not useSession or (not na(time(timeframe.period, "0930-1600", "America/New_York")))

// ── Trend
emaFast = ta.ema(close, fastLen)
emaSlow = ta.ema(close, slowLen)
htfClose = request.security(syminfo.tickerid, htf, close, lookahead=barmerge.lookahead_off)
htfFast  = request.security(syminfo.tickerid, htf, ta.ema(close, fastLen), lookahead=barmerge.lookahead_off)
htfSlow  = request.security(syminfo.tickerid, htf, ta.ema(close, slowLen), lookahead=barmerge.lookahead_off)
bullTrend = close > emaFast and emaFast > emaSlow
bearTrend = close < emaFast and emaFast < emaSlow
htfBull   = htfClose > htfFast and htfFast > htfSlow
htfBear   = htfClose < htfFast and htfFast < htfSlow
bullStructure = close > ta.highest(high[1], structureLen)
bearStructure = close < ta.lowest(low[1], structureLen)

// ── Momentum
rsi = ta.rsi(close, rsiLen)
[diPlus, diMinus, adx] = ta.dmi(adxLen, adxLen)
bullMomentum = rsi > 51 and diPlus > diMinus and adx >= adxMin
bearMomentum = rsi < 49 and diMinus > diPlus and adx >= adxMin

// ── Relative Strength
benchClose  = request.security(benchmark, timeframe.period, close, lookahead=barmerge.lookahead_off)
sectorClose = request.security(sectorSymbol, timeframe.period, close, lookahead=barmerge.lookahead_off)
stockROC  = ta.roc(close, rsLen)
benchROC  = ta.roc(benchClose, rsLen)
sectorROC = ta.roc(sectorClose, rsLen)
rsBull = not useRS or (stockROC > benchROC and stockROC > sectorROC)
rsBear = not useRS or (stockROC < benchROC and stockROC < sectorROC)

// ── VWAP
vwapValue = ta.vwap(hlc3)
vwapBull = close > vwapValue and vwapValue >= vwapValue[1]
vwapBear = close < vwapValue and vwapValue <= vwapValue[1]

// ── Volume
volAvg = ta.sma(volume, volLen)
relVol = f_safeDiv(volume, volAvg)
volumeBull = close > open and relVol >= volMultiplier
volumeBear = close < open and relVol >= volMultiplier

// ── Structure / Breakout
priorHigh = ta.highest(high[1], structureLen)
priorLow  = ta.lowest(low[1], structureLen)
bullSweep = low < priorLow and close > priorLow
bearSweep = high > priorHigh and close < priorHigh
bullBreak = close > priorHigh
bearBreak = close < priorLow
bullAcceptance = bullBreak and close[1] > priorHigh[1] and volumeBull
bearAcceptance = bearBreak and close[1] < priorLow[1] and volumeBear
bullRetest = bullBreak[1] and low <= priorHigh[1] and close > priorHigh[1]
bearRetest = bearBreak[1] and high >= priorLow[1] and close < priorLow[1]

// ── Confirmation TF
confirmClose = request.security(syminfo.tickerid, confirmTF, close, lookahead=barmerge.lookahead_off)
confirmVWAP  = request.security(syminfo.tickerid, confirmTF, ta.vwap(hlc3), lookahead=barmerge.lookahead_off)
confirmBull = confirmClose > confirmVWAP
confirmBear = confirmClose < confirmVWAP

// ── Darvas
darvasHigh = ta.highest(high, darvasLen)
darvasLow  = ta.lowest(low, darvasLen)
darvasBull = useDarvas and close > darvasHigh[1]
darvasBear = useDarvas and close < darvasLow[1]

// ── Score
int bullScore = 0
int bearScore = 0
bullScore += bullTrend ? 2 : 0
bullScore += htfBull ? 2 : 0
bullScore += bullMomentum ? 2 : 0
bullScore += rsBull ? 2 : 0
bullScore += vwapBull ? 2 : 0
bullScore += volumeBull ? 2 : 0
bullScore += (bullStructure or bullAcceptance or bullRetest) ? 2 : 0
bullScore += confirmBull ? 2 : 0
bullScore += bullSweep ? 1 : 0
bullScore += darvasBull ? 1 : 0

bearScore += bearTrend ? 2 : 0
bearScore += htfBear ? 2 : 0
bearScore += bearMomentum ? 2 : 0
bearScore += rsBear ? 2 : 0
bearScore += vwapBear ? 2 : 0
bearScore += volumeBear ? 2 : 0
bearScore += (bearStructure or bearAcceptance or bearRetest) ? 2 : 0
bearScore += confirmBear ? 2 : 0
bearScore += bearSweep ? 1 : 0
bearScore += darvasBear ? 1 : 0

// ── Risk calculation
atr = ta.atr(atrLen)
longStopCandidate  = math.min(ta.lowest(low, swingLen), close - atr * stopATR)
shortStopCandidate = math.max(ta.highest(high, swingLen), close + atr * stopATR)
longRisk  = close - longStopCandidate
shortRisk = shortStopCandidate - close
longT1 = close + longRisk * targetR1
longT2 = close + longRisk * targetR2
shortT1 = close - shortRisk * targetR1
shortT2 = close - shortRisk * targetR2
longRR  = f_safeDiv(longT2 - close, longRisk)
shortRR = f_safeDiv(close - shortT2, shortRisk)

// ── Signals (now easier to trigger)
longConfirmation  = bullAcceptance or bullRetest or (bullBreak and volumeBull and confirmBull)
shortConfirmation = bearAcceptance or bearRetest or (bearBreak and volumeBear and confirmBear)

longSetup  = isPrimary and inSession and bullScore >= minScore and longConfirmation and longRR >= minRR and htfBull and bullTrend
shortSetup = isPrimary and inSession and bearScore >= minScore and shortConfirmation and shortRR >= minRR and htfBear and bearTrend
longSignal  = longSetup and not shortSetup
shortSignal = shortSetup and not longSetup

// ── Position sizing
riskAmount = strategy.equity * (riskPercent / 100.0)
longQty  = longRisk  > 0 ? riskAmount / longRisk  : na
shortQty = shortRisk > 0 ? riskAmount / shortRisk : na

if longSignal and strategy.position_size <= 0
    strategy.entry("LONG", strategy.long, qty=longQty)
if shortSignal and strategy.position_size >= 0
    strategy.entry("SHORT", strategy.short, qty=shortQty)

// ── Trailing management
var float activeLongStop  = na
var float activeShortStop = na
var bool  longT1hit       = false
var bool  shortT1hit      = false

if strategy.position_size > 0
    if strategy.position_size[1] <= 0
        activeLongStop := math.min(ta.lowest(low, swingLen), strategy.position_avg_price - atr * stopATR)
        longT1hit := false
    longRiskLive = strategy.position_avg_price - activeLongStop
    liveLongT1   = strategy.position_avg_price + longRiskLive * targetR1
    liveLongT2   = strategy.position_avg_price + longRiskLive * targetR2
    if not longT1hit and high >= liveLongT1
        longT1hit := true
        activeLongStop := strategy.position_avg_price
    if trailAfterT1 and longT1hit
        trailLevel = close - atr * trailATRmult
        activeLongStop := math.max(activeLongStop, trailLevel)
    strategy.exit("L-T1", "LONG", stop=activeLongStop, limit=liveLongT1, qty_percent=50)
    strategy.exit("L-T2", "LONG", stop=activeLongStop, limit=liveLongT2, qty_percent=50)

if strategy.position_size < 0
    if strategy.position_size[1] >= 0
        activeShortStop := math.max(ta.highest(high, swingLen), strategy.position_avg_price + atr * stopATR)
        shortT1hit := false
    shortRiskLive = activeShortStop - strategy.position_avg_price
    liveShortT1   = strategy.position_avg_price - shortRiskLive * targetR1
    liveShortT2   = strategy.position_avg_price - shortRiskLive * targetR2
    if not shortT1hit and low <= liveShortT1
        shortT1hit := true
        activeShortStop := strategy.position_avg_price
    if trailAfterT1 and shortT1hit
        trailLevel = close + atr * trailATRmult
        activeShortStop := math.min(activeShortStop, trailLevel)
    strategy.exit("S-T1", "SHORT", stop=activeShortStop, limit=liveShortT1, qty_percent=50)
    strategy.exit("S-T2", "SHORT", stop=activeShortStop, limit=liveShortT2, qty_percent=50)

if strategy.position_size == 0
    activeLongStop  := na
    activeShortStop := na
    longT1hit       := false
    shortT1hit      := false

// ============================================================================
// CLEAN CHART UI (same kid-friendly style)
// ============================================================================
prevHigh = request.security(syminfo.tickerid, "D", high[1], lookahead=barmerge.lookahead_off)
prevLow  = request.security(syminfo.tickerid, "D", low[1], lookahead=barmerge.lookahead_off)
recentResistance = ta.highest(high[1], 10)
recentSupport    = ta.lowest(low[1], 10)
wideResistance   = ta.highest(high[1], 50)
wideSupport      = ta.lowest(low[1], 50)

float immediateResistance = recentResistance > close ? recentResistance : na
float immediateSupport    = recentSupport < close ? recentSupport : na
float strongResistance = na
float strongSupport    = na

if not na(immediateResistance)
    strongResistance := prevHigh > immediateResistance ? prevHigh : wideResistance
else
    strongResistance := prevHigh > close ? prevHigh : wideResistance
if not na(immediateSupport)
    strongSupport := prevLow < immediateSupport ? prevLow : wideSupport
else
    strongSupport := prevLow < close ? prevLow : wideSupport

if not na(immediateResistance) and not na(strongResistance) and strongResistance <= immediateResistance
    strongResistance := wideResistance
if not na(immediateSupport) and not na(strongSupport) and strongSupport >= immediateSupport
    strongSupport := wideSupport

var line iResLine = na
var line sResLine = na
var line iSupLine = na
var line sSupLine = na
var label iResLab = na
var label sResLab = na
var label iSupLab = na
var label sSupLab = na

if barstate.islast
    line.delete(iResLine)
    line.delete(sResLine)
    line.delete(iSupLine)
    line.delete(sSupLine)
    label.delete(iResLab)
    label.delete(sResLab)
    label.delete(iSupLab)
    label.delete(sSupLab)

    int leftBar  = bar_index - 8
    int rightBar = bar_index + 12

    if not na(immediateResistance)
        iResLine := line.new(leftBar, immediateResistance, rightBar, immediateResistance, color=color.new(color.red, 10), width=2)
        iResLab  := label.new(rightBar, immediateResistance, "Immediate Resistance", style=label.style_label_left, textcolor=color.white, color=color.new(color.red, 20), size=size.small)

    if not na(strongResistance)
        sResLine := line.new(leftBar, strongResistance, rightBar, strongResistance, color=color.new(color.red, 50), width=2, style=line.style_dashed)
        sResLab  := label.new(rightBar, strongResistance, "Strong Resistance", style=label.style_label_left, textcolor=color.white, color=color.new(color.red, 50), size=size.small)

    if not na(immediateSupport)
        iSupLine := line.new(leftBar, immediateSupport, rightBar, immediateSupport, color=color.new(color.green, 10), width=2)
        iSupLab  := label.new(rightBar, immediateSupport, "Immediate Support", style=label.style_label_left, textcolor=color.white, color=color.new(color.green, 20), size=size.small)

    if not na(strongSupport)
        sSupLine := line.new(leftBar, strongSupport, rightBar, strongSupport, color=color.new(color.green, 50), width=2, style=line.style_dashed)
        sSupLab  := label.new(rightBar, strongSupport, "Strong Support", style=label.style_label_left, textcolor=color.white, color=color.new(color.green, 50), size=size.small)

// Signal labels (pushed away from candles)
if longSignal
    label.new(bar_index, low - atr * 0.9,
         "BUY\nEntry " + str.tostring(close, format.mintick) +
         "\nSL " + str.tostring(longStopCandidate, format.mintick) +
         "\nT1 " + str.tostring(longT1, format.mintick) +
         "\nT2 " + str.tostring(longT2, format.mintick),
         style=label.style_label_up, textcolor=color.white, color=color.green, size=size.normal)

if shortSignal
    label.new(bar_index, high + atr * 0.9,
         "SELL\nEntry " + str.tostring(close, format.mintick) +
         "\nSL " + str.tostring(shortStopCandidate, format.mintick) +
         "\nT1 " + str.tostring(shortT1, format.mintick) +
         "\nT2 " + str.tostring(shortT2, format.mintick),
         style=label.style_label_down, textcolor=color.white, color=color.red, size=size.normal)

alertcondition(longSignal,  "V3 BUY CONFIRMED",  "V3 BUY confirmed on {{ticker}} {{interval}}")
alertcondition(shortSignal, "V3 SELL CONFIRMED", "V3 SELL confirmed on {{ticker}} {{interval}}")
